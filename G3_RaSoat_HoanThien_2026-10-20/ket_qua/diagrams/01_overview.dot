digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.7, splines=polyline, fontname="Arial"];
node [shape=record, fontname="Arial", fontsize=13, style="filled", fillcolor="#f7f9fc", color="#566779", margin="0.15,0.10"];
edge [dir=none, fontname="Arial", fontsize=11, color="#53677c", labeldistance=1.5];
users [label="{users|user_id PK\lemail UQ\l}"];
clients [label="{clients|client_id PK FK\l}"];
freelancers [label="{freelancers|freelancer_id PK FK\l}"];
skills [label="{skills|skill_id PK\lskill_name UQ\l}"];
freelancer_skills [label="{freelancer_skills|freelancer_id PK FK\lskill_id PK FK\l}"];
job_categories [label="{job_categories|category_id PK\lcategory_name UQ\l}"];
jobs [label="{jobs|job_id PK\lclient_id FK\lcategory_id FK\l}"];
proposals [label="{proposals|proposal_id PK\ljob_id FK\lfreelancer_id FK\lUQ(job_id, freelancer_id)\l}"];
contracts [label="{contracts|contract_id PK\lproposal_id FK UQ\lclient_id FK\lfreelancer_id FK\l}"];
milestones [label="{milestones|milestone_id PK\lcontract_id FK\l}"];
payments [label="{payments|payment_id PK\lmilestone_id FK\l}"];
contract_reviews [label="{contract_reviews|contract_id PK FK\l}"];
users -> clients [taillabel="1",headlabel="0..1"];
users -> freelancers [taillabel="1",headlabel="0..1"];
freelancers -> freelancer_skills [taillabel="1",headlabel="0..*"];
skills -> freelancer_skills [taillabel="1",headlabel="0..*"];
clients -> jobs [taillabel="1",headlabel="0..*"];
job_categories -> jobs [taillabel="1",headlabel="0..*"];
jobs -> proposals [taillabel="1",headlabel="0..*"];
freelancers -> proposals [taillabel="1",headlabel="0..*"];
proposals -> contracts [taillabel="1",headlabel="0..1"];
clients -> contracts [taillabel="1",headlabel="0..*"];
freelancers -> contracts [taillabel="1",headlabel="0..*"];
contracts -> milestones [taillabel="1",headlabel="0..*"];
milestones -> payments [taillabel="1",headlabel="0..*"];
contracts -> contract_reviews [taillabel="1",headlabel="0..1"];
specialization [shape=note,label="USER specialization\nTotal and disjoint\nExactly one subtype per user",fontsize=12,fillcolor="white"]; users -> specialization [style=dashed];
rules [shape=note,label="Conditional uniqueness\nOne selected proposal per job\nOne PAID attempt per milestone\nReview only after completion",fontsize=12,fillcolor="white"]; payments -> rules [style=dashed];
}
